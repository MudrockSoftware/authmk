<Layouts.app flash={@flash}>
  <h1 class="text-2xl font-semibold">PhoenixApp</h1>
  <p :if={@current_user && @current_user.is_anonymous} class="mt-4">Signed in as a guest</p>
  <p :if={@current_user && !@current_user.is_anonymous} class="mt-4">
    Signed in as {@current_user.email}
  </p>
  <div :if={!@current_user} class="mt-4">
    <p>You are not signed in.</p>
    <%!-- POST /auth/sign-in/email sets the session cookie. --%>
    <form id="sign-in" class="mt-4 flex gap-2" onsubmit="signIn(event)">
      <input name="email" type="email" placeholder="Email" class="input" required />
      <input name="password" type="password" placeholder="Password" class="input" required />
      <button class="btn btn-primary">Sign in</button>
    </form>
    <p :if={@last_used} class="mt-2">Last time you signed in with {@last_used}.</p>
    <%!-- POST /auth/sign-in/social answers with the provider's URL to go to. --%>
    <button
      :for={provider <- @providers}
      class="btn mt-4"
      data-provider={provider}
      onclick="signInWith(this.dataset.provider)"
    >
      Sign in with {Phoenix.Naming.humanize(provider)}
      <span :if={to_string(provider) == @last_used} class="badge">Last used</span>
    </button>
  </div>
  <script>
    async function signIn(event) {
      event.preventDefault()
      const form = new FormData(event.target)
      const response = await fetch("/auth/sign-in/email", {
        method: "POST",
        headers: {"content-type": "application/json"},
        body: JSON.stringify({email: form.get("email"), password: form.get("password")})
      })
      if (response.ok) window.location.reload()
      else alert((await response.json()).error.message)
    }

    async function signInWith(provider) {
      const response = await fetch("/auth/sign-in/social", {
        method: "POST",
        headers: {"content-type": "application/json"},
        body: JSON.stringify({provider, callback_url: "/account"})
      })
      const {url} = await response.json()
      if (url) window.location.href = url
    }
  </script>
</Layouts.app>
